  /******************************************************************************************
   Module          	: TBUF_X1
   Cell Description	: Combinational tri-state cell (TBUF_X1) with drive strength X1
  *******************************************************************************************/

  cell(AND2_X1) { 
    area : 0.042 ; 
    cell_leakage_power : 354.6 ; 

    leakage_power() { 
      when : "A1&A2" ; 
      value : "741.4" ; 
    }

    leakage_power() { 
      when : "!A1&!A2" ; 
      value : "354.6" ; 
    }

    leakage_power() { 
      when : "A1&!A2" ; 
      value : "544.4" ; 
    }

    leakage_power() { 
      when : "!A1&A2" ; 
      value : "553.3" ; 
    }
    rail_connection(VDD, RAIL_VDD);
    rail_connection(VSS, RAIL_VSS);

    pin(A1) { 
      direction : input ; 
      driver_waveform_rise : "driver_waveform_default_rise" ; 
      driver_waveform_fall : "driver_waveform_default_fall" ; 
      fall_capacitance : 1.105 ; 
      fall_capacitance_range(0.6474, 1.105);
      input_signal_level : RAIL_VDD ; 
      capacitance : 1.105 ; 
      max_transition : 0.6 ; 
      rise_capacitance : 1.1 ; 
      rise_capacitance_range(0.6427, 1.1);

      internal_power() { 

        rise_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("-0.3196, -0.3195, -0.3194, -0.3195, -0.3198, -0.3197, -0.32");
        }

        fall_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("0.3493, 0.3493, 0.3492, 0.3493, 0.3494, 0.3493, 0.3494");
        }
      }
    }

    pin(A2) { 
      direction : input ; 
